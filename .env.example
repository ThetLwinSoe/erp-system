# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=erp_database
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=24h

# Cloudflare R2 (company logo storage) - required in every environment,
# including local dev. Use a separate bucket/token per environment
# (e.g. coreflow-erp-logos-dev locally, coreflow-erp-logos on Render).
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=coreflow-erp-logos-dev
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev
